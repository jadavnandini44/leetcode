from typing import List

class Solution:
    def solveNQueens(self, n: int) -> List[List[str]]:
        def canweplace(row, col, mat):
            r, c = row, col
            # check upper-left diagonal
            while r >= 0 and c >= 0:
                if mat[r][c] == "Q":
                    return False
                r -= 1
                c -= 1

            r, c = row, col
            # check column
            while r >= 0:
                if mat[r][c] == "Q":
                    return False
                r -= 1

            r, c = row, col
            # check upper-right diagonal
            while r >= 0 and c < n:
                if mat[r][c] == "Q":
                    return False
                r -= 1
                c += 1

            return True

        def backtrack(row, mat, ans, n):
            if row == n:
                temp = []
                for r in mat:
                    temp.append("".join(r))
                ans.append(temp)
                return
            for col in range(n):
                if canweplace(row, col, mat):
                    mat[row][col] = "Q"
                    backtrack(row + 1, mat, ans, n)
                    mat[row][col] = "."

        # initialize board
        mat = [["."] * n for _ in range(n)]
        ans = []
        backtrack(0, mat, ans, n)
        return ans
